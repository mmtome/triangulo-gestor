# Copie para .env e preencha.

# Desenvolvimento local (SQLite, sem infraestrutura)
DATABASE_URL="file:./dev.db"

# Produção (PostgreSQL) — ver prisma/schema.postgres.prisma
# DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Segredo da sessão JWT. Gere um novo em produção:
#   openssl rand -base64 32
AUTH_SECRET="troque-este-valor-em-producao"
